rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Only these Google accounts can see or change anything in the admin panel.
    // Keep in sync with src/lib/admins.js.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['bhoomiarun5@gmail.com', 'anirudhsandilya363@gmail.com'];
    }

    // Players are not signed in. They may create their own entry and keep updating it while
    // playing, but can never list or read anyone's entries (so other doc ids stay unknown).
    match /participants/{id} {
      allow read, delete: if isAdmin();

      allow create: if isAdmin() || (
        request.resource.data.keys().hasOnly(['name', 'nameLower', 'status', 'answers', 'score', 'answered', 'total', 'createdAt', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 30
        && request.resource.data.status in ['started', 'skipped']
        && request.resource.data.answers is list
        && request.resource.data.answers.size() <= 16
      );

      allow update: if isAdmin() || (
        resource.data.status == 'started'
        && request.resource.data.status in ['started', 'completed']
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['answers', 'score', 'answered', 'status', 'updatedAt', 'completedAt'])
        && request.resource.data.answers is list
        && request.resource.data.answers.size() <= 16
      );
    }

    // Gaade text, photos and grading settings: everyone can read (the game needs them),
    // only admins can change them.
    match /gaades/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /gaadeImages/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /config/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
