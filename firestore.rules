rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Only these Google accounts can see or change anything in the admin panel.
    // Keep in sync with src/lib/admins.js.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['bhoomiarun5@gmail.com', 'anirudhsandilya363@gmail.com'];
    }

    // Players are not signed in. They may create their own entry, update it while playing, and
    // reset it to play again. They can never list or read anyone's entries, and doc ids are not
    // stored anywhere public, so only the phone that created an entry knows its id.
    match /participants/{id} {
      allow read, delete: if isAdmin();

      allow create: if isAdmin() || (
        request.resource.data.keys().hasOnly(['name', 'nameLower', 'status', 'answers', 'score', 'answered', 'total', 'attempt', 'createdAt', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 40
        && request.resource.data.status in ['started', 'skipped']
        && request.resource.data.answers is list
        && request.resource.data.answers.size() <= 16
      );

      // While playing: started -> started/completed. Play again: any status -> started (reset).
      allow update: if isAdmin() || (
        request.resource.data.status in ['started', 'completed']
        && (resource.data.status == 'started' || request.resource.data.status == 'started')
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['answers', 'score', 'answered', 'status', 'attempt', 'updatedAt', 'completedAt'])
        && request.resource.data.answers is list
        && request.resource.data.answers.size() <= 16
      );
    }

    // Name registry: keeps player names unique. The game may look up one exact name (get) but
    // cannot list them. A name is claimed in the same batch that creates the participant. Writing to
    // an existing name is an update, which nobody may do (not even admins, since an admin who is
    // signed in on a device also plays the game with admin rights) — so a taken name cannot be
    // claimed twice. Admins free a name by deleting it.
    match /names/{key} {
      allow get: if true;
      allow list, delete: if isAdmin();
      allow update: if false;
      allow create: if isAdmin() || (
        request.resource.data.keys().hasOnly(['name', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 40
      );
    }

    // Gaade text, photos and grading settings: everyone can read (the game needs them),
    // only admins can change them.
    match /gaades/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /gaadeImages/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /config/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
